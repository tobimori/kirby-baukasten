{
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "vite",
		"dev:portless": "portless run --name \"$(basename \"$(dirname \"$(git rev-parse --path-format=absolute --git-common-dir)\")\")\"",
		"dev:plugin": "cd site/plugins/extended && kirbyup serve src/index.js",
		"build": "pnpm run \"/build:/\"",
		"build:site": "vite build",
		"build:plugin": "cd site/plugins/extended && kirbyup src/index.js",
		"types": "kirby types:create --force && tsc --noEmit",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"content:pull": "bash scripts/content.sh pull",
		"content:push": "bash scripts/content.sh push"
	},
	"dependencies": {
		"@alpinejs/focus": "^3.17.4",
		"@alpinejs/intersect": "^3.17.4",
		"alpinejs": "^3.17.4",
		"htmx.org": "^2.0.11",
		"idiomorph": "^0.8.0",
		"unlazy": "^2.0.1"
	},
	"devDependencies": {
		"@spiriit/vite-plugin-svg-spritemap": "^7.2.0",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/vite": "4.3.3",
		"@total-typescript/ts-reset": "^0.6.1",
		"@types/alpinejs": "^3.17.0",
		"@types/alpinejs__focus": "^3.13.4",
		"@types/alpinejs__intersect": "^3.13.4",
		"@types/node": "^26.6.5",
		"browserslist": "^4.29.3",
		"kirbyup": "^3.5.0",
		"laravel-vite-plugin": "^3.2.0",
		"lightningcss": "^1.33.0",
		"oxfmt": "^0.73.0",
		"oxlint": "^1.88.0",
		"portless": "^0.15.7",
		"svgo": "^4.1.0",
		"tailwindcss": "^4.3.3",
		"typescript": "^7.0.2",
		"vite": "^8.3.4",
		"vite-plugin-compression2": "^2.5.3",
		"vite-plugin-devtools-json": "^1.1.2"
	},
	"browserslist": [
		"last 2 versions",
		">= 0.4%",
		"not dead",
		"Firefox ESR",
		"not op_mini all",
		"not and_uc > 0"
	],
	"packageManager": "pnpm@12.11.2"
}
